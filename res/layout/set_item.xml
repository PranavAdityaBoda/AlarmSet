<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
    android:background="@drawable/bg_card" android:gravity="center_vertical"
    android:paddingStart="20dp" android:paddingEnd="8dp" android:paddingTop="16dp" android:paddingBottom="16dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/range" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/on_bg" android:textSize="20sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="14sp"/>
    </LinearLayout>

    <ImageView android:id="@+id/load" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp" android:src="@drawable/ic_alarm" android:tint="@color/primary"
        android:background="@drawable/bg_text_action" android:contentDescription="Set these alarms"
        android:clickable="true" android:focusable="true"/>
    <ImageView android:id="@+id/delete" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp" android:src="@drawable/ic_delete" android:tint="@color/muted"
        android:background="@drawable/bg_text_action" android:contentDescription="Delete set"
        android:clickable="true" android:focusable="true"/>
</LinearLayout>
